import random

board = [' ' for _ in range(9)]


def display_board():
    print()
    print(f" {board[0]} | {board[1]} | {board[2]} ")
    print("---|---|---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---|---|---")
    print(f" {board[6]} | {board[7]} | {board[8]} ")
    print()


def check_win(mark):
    winning_positions = [
        (0, 1, 2),  # Row 1
        (3, 4, 5),  # Row 2
        (6, 7, 8),  # Row 3
        (0, 3, 6),  # Column 1
        (1, 4, 7),  # Column 2
        (2, 5, 8),  # Column 3
        (0, 4, 8),  # Diagonal
        (2, 4, 6)   # Diagonal
    ]

    for a, b, c in winning_positions:
        if board[a] == mark and board[b] == mark and board[c] == mark:
            return True

    return False


def check_draw():
    return ' ' not in board


def human_move():
    while True:
        try:
            position = int(input("Enter your position (1-9): "))

            if position < 1 or position > 9:
                print("Please enter a number between 1 and 9.")
                continue

            index = position - 1

            if board[index] != ' ':
                print("That position is already occupied. Try again.")
            else:
                board[index] = 'X'
                break

        except ValueError:
            print("Please enter a valid number.")


def computer_move():
    available_positions = [
        i for i in range(9) if board[i] == ' '
    ]

    position = random.choice(available_positions)
    board[position] = 'O'

    print(f"Computer chose position {position + 1}.")


def main():
    print("===== TIC-TAC-TOE =====")
    print("You are X.")
    print("Computer is O.")

    print("\nBoard positions:")
    print(" 1 | 2 | 3 ")
    print("---|---|---")
    print(" 4 | 5 | 6 ")
    print("---|---|---")
    print(" 7 | 8 | 9 ")

    while True:
        # Human's turn
        display_board()
        human_move()

        if check_win('X'):
            display_board()
            print("Congratulations! You win!")
            break

        if check_draw():
            display_board()
            print("It's a draw!")
            break

        # Computer's turn
        computer_move()

        if check_win('O'):
            display_board()
            print("Computer wins!")
            break

        if check_draw():
            display_board()
            print("It's a draw!")
            break


main()
